{
  "name": "stagemate",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install && cd client && npm install && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git@github-jstrodev:jstrodev/StageMate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "**tl;dr:** A platform for venues to search for and discover musicians.",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.0.0",
    "nodemon": "^2.0.22"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  }
}
